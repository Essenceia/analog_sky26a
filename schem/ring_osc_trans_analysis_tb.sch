C {sky130_fd_pr/corner.sym} -1140 -150 0 0 {name=CORNER only_toplevel=true corner=tt}
C {devices/simulator_commands_shown.sym} -1660 -170 0 0 {name=COMMAND1
simulator=ngspice
only_toplevel=false 
value="
.include slow_osc.save
* 320 MHz : 4f RW=1 PW=1.12 PL=0.45 NW=0.740 NL=0.45
* 250 MHz : 4f PW=1.12 PL=0.5 NW=0.82 NL=0.5
* 260 MHz : 4f PW=0.82 PL=0.5 NW=0.55 NL=0.5
* 100 MHz : 4f PW=1.5 PL=1.0 NW=1.0 NL=1.0
* 18 MHz :  4f PW=7.0 PL=0.25 NW=1.0 NL=8.0
* 30 MHz : CX=64f RW=1 PW=1.5 PL=1.0 NW=1.0 NL=1.0
* 30 MHz : looks clean CX=64f PW=2.0 PL=1.0 NW=1.0 NL=1.0
* version with mim cap CW=6 CL=5 PW=2.0 PL=1.0 NW=1.0 NL=1.0
.param CW=6 CL=5 PW=2.0 PL=1.0 NW=1.0 NL=1.0
.tran 0.02n 200n
.save all
.control
  reset
  run
  write slow_osc.raw
  quit 0
.endc
"}
